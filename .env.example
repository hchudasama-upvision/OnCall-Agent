# Copy to .env and fill in. .env is gitignored — never commit it.
# Nothing in this repo is hardcoded; every credential is read from here.

# ============================== SLACK ==============================
# Bot User OAuth token (xoxb-…). Scopes needed:
#   channels:history  read #alerts-devops and #comms-noc (groups:history if private)
#   channels:read     only if you put channel NAMES below instead of IDs
#   chat:write        post the incident thread
#   files:write       attach screenshots and logs
SLACK_BOT_TOKEN=xoxb-...

# User OAuth token (xoxp-…). OPTIONAL but this is the one that unlocks the
# agent investigating for itself. Reads happen AS YOU — the same access
# Claude's Slack connector has — so #comms-noc search and history work without
# granting the bot app anything new. Scopes: search:read, channels:history
# (groups:read/groups:history for private channels).
#   set   -> INVESTIGATION=auto picks "tools": Claude searches #comms-noc,
#            opens the threads, and reads what was actually done.
#   unset -> "prefetch": we keyword-fetch a few threads and hand them over.
# Writes NEVER use this token — posting is always the bot token below, so a
# prompt that can read a channel can never post to it.
# SLACK_USER_TOKEN=xoxp-...

# tools | prefetch | auto (default). Force "tools" only if the bot token has
# channels:history; otherwise the run burns minutes to conclude it read nothing.
# INVESTIGATION=auto

# App-level token (xapp-…, scope connections:write). OPTIONAL.
#   set   -> Socket Mode: real-time alerts, and Approve/Deny buttons work
#   unset -> polling: conversations.history every POLL_SECONDS, no buttons
# SLACK_APP_TOKEN=xapp-...

# ============================ PROFILE / CHANNELS ============================
# test (default)  channels must be named explicitly below — this is the mode
#                 for a test workspace.
# production      channels default to the real Veritone #alerts-devops
#                 (C909ZH4ET) and #comms-noc (C01F810QM96).
#
# There is no silent production default: an .env that forgets ALERTS_CHANNEL
# used to aim at the real NOC channel, and --live would have posted there.
# Reaching production is now a stated decision.
#
# Remember a Slack token only sees its OWN workspace — the channels here and
# SLACK_BOT_TOKEN above must belong to the same one.
PROFILE=test

# Where alerts are READ from (id or name, no leading #).
ALERTS_CHANNEL=

# Where the agent POSTS. The repo's original variable name; takes precedence
# over COMMS_CHANNEL.
SLACK_CHANNEL=

# Where past resolutions are READ from, if different from where it posts.
# Defaults to the post channel. Point it at the real #comms-noc when a token
# can read it — that history is the strongest grounding the agent has.
# HISTORY_CHANNEL=

# ============================ AGENT BEHAVIOR ============================
# dry_run (default): investigate for real, print the thread instead of posting.
# live: post to Slack. DESIGN.md §6 prescribes running in shadow mode first.
POST_MODE=dry_run

# victorops (default): only VictorOps INCIDENTS start an investigation. Raw
#   Alertmanager/PandoLogic/Jenkins posts stay correlation context — that is
#   the v1.1 scope refinement, and #alerts-devops carries dozens of those an hour.
# all: investigate every alert-shaped message. Noisy; use with a suppression list.
# TRIGGER_ON=victorops

# POLL_SECONDS=60             # polling transport only
# LOOKBACK_MINUTES=15         # cold start: how far back to look with no cursor
# DEDUPE_WINDOW_MINUTES=60    # same fingerprint inside this window = one incident
# EVIDENCE_DIR=./dist/evidence
# STATE_DIR=./.state

# ================================ LLM ================================
# claude_cli (default): headless Claude Code (`claude -p`). Auth is the CLI's
#   own login in ~/.claude — no API key, no metered credits. Run `claude` once
#   interactively first; headless cannot complete an OAuth flow.
# anthropic: the Anthropic API directly (needs a funded key).
# LLM_PROVIDER=claude_cli
# CLAUDE_CLI_MODEL=opus       # alias (opus|sonnet|fable) or a full model id
# CLAUDE_CLI_EFFORT=low       # low|medium|high|xhigh|max — the triage-depth knob
# CLAUDE_CLI_TIMEOUT=300      # seconds per call
# INVESTIGATE_TIMEOUT=900      # seconds for one tool-using investigation
# CLAUDE_BIN=/path/to/claude  # only if `claude` is not on PATH
#
# Only for LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5
# LLM_MAX_TOKENS=8000

# ============================== GRAFANA ==============================
# Graph evidence for the incident thread. Optional: without it the agent
# still gathers Edge UI evidence and still triages, it just attaches no graphs.
GRAFANA_URL=https://thanos-grafana.ops.veritone.com
GRAFANA_API_TOKEN=glsa_...          # service account, Viewer role is enough

# How panel PNGs are produced:
#   auto (default) — /render API when the image-renderer plugin is installed,
#                    otherwise a headless browser. thanos-grafana has NO
#                    renderer plugin (checked 2026-08-24), so it takes the
#                    browser path; that needs `playwright install-deps`.
#   render | browser | off
# GRAFANA_CAPTURE=auto
# GRAFANA_THEME=light         # dark to match what you see in your browser
# GRAFANA_PANEL_WIDTH=1000
# GRAFANA_PANEL_HEIGHT=500
# GRAFANA_SETTLE_MS=2500      # wait after load so panels finish querying
# PANEL_FROM=now-6h           # default window for mapped panels

# Only for a Cloudflare-Access-protected instance when this process is NOT
# already inside the tunnel (headless/cron). Service tokens are issued by
# whoever administers Cloudflare Access — not self-serve.
# CF_ACCESS_CLIENT_ID=...
# CF_ACCESS_CLIENT_SECRET=...

# ========================== aiWARE EDGE / CONTROLLER ==========================
# Engine-failure incidents are investigated against the real Edge UI:
# task stats via the JSON API, plus Playwright screenshots of the Tasks and
# Engine pages and the downloaded task/job logs.
EDGE_USERNAME=            # Edge UI login, for the browser screenshots
EDGE_PASSWORD=

# One URL+token pair per environment, keyed by the aiw-xxx name that appears
# in the alert. Only "processing.*" hosts are wired up — the edge-admin.*
# hosts (STG198/PRD9/PRD8) have not been confirmed to serve the same API.
EDGE_PROD1001_URL=https://processing.prod1001.aiware.run
EDGE_PROD1001_TOKEN=
EDGE_PRD5001_URL=
EDGE_PRD5001_TOKEN=
EDGE_UKPROD_URL=
EDGE_UKPROD_TOKEN=
EDGE_BMG1015_URL=
EDGE_BMG1015_TOKEN=
EDGE_ZPFC02_URL=
EDGE_ZPFC02_TOKEN=
EDGE_GOV1_URL=
EDGE_GOV1_TOKEN=
EDGE_DMH_URL=
EDGE_DMH_TOKEN=
EDGE_CA1_URL=
EDGE_CA1_TOKEN=

# ============================== RUNSCOPE ==============================
# Not yet consumed by the agent; kept so the .env stays the single place
# credentials live.
# RUNSCOPE_API_TOKEN=
# RUNSCOPE_TEAM_UUID=

# ---------------------------------------------------------------- Kubernetes
# Read-only kubectl for the Kubernetes specialist (pod state, logs, replica
# peers). NOT a credential: it points at the kubeconfigs a human generated with
# ~/eks/generate-kube-config.sh, and kubectl uses the AWS profile named in each
# cluster's own .envrc. Same deliberate exception as the `gh` CLI — see
# py/oncall_agent/Agents/K8S_Agent/kubectl_client.py.
KUBECONFIG_DIR=~/eks
# Which ~/eks/<environment>/ directories may be used AT ALL. Stage only by
# default: every call is a read, but a prod cluster reached because an alert
# parsed oddly is still a surprise. Add "prod" deliberately, not casually.
KUBE_ENVIRONMENTS=stage
# Per-call kubectl timeout, seconds.
KUBECTL_TIMEOUT=60

# ------------------------------------------- API response-code re-check
# Alerts like "US-Prod Response Codes - nginx -ai13s" are answered by the
# "API Services - Overview" dashboard, and the runbook's first step is to wait
# 5-10 minutes for self-heal. follow_up.py re-checks on this schedule and posts
# the recovered (or still-below) success rate plus a fresh screenshot into the
# SAME thread. Minutes after the first post; set to a fraction for testing
# (FOLLOW_UP_MINUTES=0.2,0.4 makes a replay finish in seconds).
FOLLOW_UP_MINUTES=5,10
# A re-check resumed after a restart is dropped if it is older than this — a
# "recovered" line arriving an hour late is noise, not news.
FOLLOW_UP_MAX_AGE_MINUTES=45
# The threshold that decides "recovered", as a ratio: 0.9999 == 99.99%. This is
# a CODE decision (CLAUDE.md non-negotiable #1), never the model's.
API_RECOVERY_THRESHOLD=0.9999
# The window the re-check measures over, and the pinned dashboard.
API_HEALTH_WINDOW=now-15m
API_HEALTH_DASHBOARD_UID=da6b8dc3-ecd3-4b8c-b7e4e

# --------------------------------------------------- change / ITSM context
# Channels where planned work is announced: deploys, maintenance windows, ITSM
# change records. search_recent_changes reads these before an EndpointDown (or
# any alert) is treated as an incident — an endpoint down inside its own
# maintenance window is not an outage. EMPTY by default on purpose: reading the
# wrong channel and reporting "no change found" is worse than reporting that the
# check was not configured.
#
# CONFIRMED 2026-09-11 by reading the real history: #team-noc-pandologic
# (C08FUDXV5T9) is where the PandoLogic engineers announce the work that causes
# the Windows/IIS service alerts, in plain language ("I`ll disconnect WEB30 from
# the load balancer and restart lots of services from it ... 0.5 to 2 hours").
# Every one of those alerts on 2026-09-10 was explained by a message there, so
# this is the highest-value channel to set. Comma-separated channel IDs:
#   CHANGE_CHANNELS=C08FUDXV5T9
CHANGE_CHANNELS=

# ------------------------------------------------------------------ AWS (RDS)
# The AWS specialist (RDS CPU/connection alerts) shells out to the `aws` CLI
# using the operator's own SSO session — `aws sso login --profile <name>`. No
# credential belongs here; these two only bound WHERE it may look.
# AWS_PROFILES is an allow-list: an alert cannot steer the agent into an
# account nobody named. Empty falls back to AWS_PROFILE/default.
AWS_PROFILES=main,us-1-gov,uk-prod
AWS_REGIONS=us-east-1,eu-west-2,us-gov-west-1
AWS_CLI_TIMEOUT=90
# Testing only: pin the instance the +5/+10min usage re-check re-renders,
# instead of resolving it from the alert text.
# FOLLOW_UP_RDS_INSTANCE=stage-core-rds2

# --------------------------------------------------------------- Thanos (direct)
# The Thanos query API and UI, used for PromQL-rule alerts ("High
# concurrent_requests for core-admin-server"): the ALERTING RULES live here, so
# the threshold and selector are looked up rather than guessed. Reachable with no
# auth from inside the VPN. NOT the same host as GRAFANA_URL.
THANOS_URL=https://thanos.ops.veritone.com
THANOS_TIMEOUT=45
# Window the +5/+10min re-check measures and graphs.
FOLLOW_UP_THANOS_HOURS=6

# --------------------------------------------------- Windows VM (read-only)
# ONLY needed for hosts without windows_exporter: with the exporter, per-process
# CPU/memory already comes from Thanos and no login is used at all.
# The WinRM surface runs a fixed set of read-only PowerShell queries chosen BY
# NAME — it cannot run an arbitrary command (Agents/Windows_Agent/winrm_client.py).
# Use a READ-ONLY SERVICE ACCOUNT here, not a person's domain login: this
# credential can reach every VM in the domain while the agent needs four counters.
WINDOWS_USERNAME=
WINDOWS_PASSWORD=
WINRM_PORT=5985
WINRM_TRANSPORT=ntlm
WINRM_TIMEOUT=40
WINDOWS_DNS_SUFFIXES=pandostaging.local,verimatch.com
WINDOWS_PROCESS_WINDOW=5m
